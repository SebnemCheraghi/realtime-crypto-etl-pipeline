      {
        "id": 2,
        "title": "Daily Aggregated Price ",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_default" },
            "format": 0,
            "rawSql": "SELECT toStartOfDay(timestamp) AS time, currency_id, avg(current_price) AS avg_price FROM crypto_prices WHERE $__timeFilter(timestamp) GROUP BY time, currency_id ORDER BY time",
